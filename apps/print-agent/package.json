{
  "name": "@retroburger/print-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente local de impresión ESC/POS: recoge la cola de la API y la envía a impresoras térmicas (red TCP 9100 o dispositivo).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.9.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
