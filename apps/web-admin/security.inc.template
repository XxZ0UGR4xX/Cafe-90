# Cabeceras de seguridad. Se incluye en CADA location que usa add_header (nginx no hereda add_header si el location define alguno).
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${API_ORIGIN} ${API_WS_ORIGIN}; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
# Buscadores: el admin nunca se indexa (ROBOTS_TAG="noindex, nofollow"); el sitio público lo sobrescribe con "all"
add_header X-Robots-Tag "${ROBOTS_TAG}" always;
