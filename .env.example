# Copiar a .env (NUNCA commitear valores reales)
NODE_ENV=development
PORT=3000
# Conexión de la aplicación (rol SIN BYPASSRLS)
DATABASE_URL=postgres://retroburger_app:CHANGE_ME@localhost:5432/retroburger
# Conexión de migraciones (rol dueño de las tablas)
DATABASE_MIGRATE_URL=postgres://retroburger_owner:CHANGE_ME@localhost:5432/retroburger
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_xxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false
LOG_LEVEL=info
# 2FA TOTP: clave de cifrado de secretos (obligatoria en producción) y obligatoriedad para ADMIN/SUPER_ADMIN
MFA_ENCRYPTION_KEY=CHANGE_ME_MIN_32_CHARS_yyyyyyyyyyyyyyyyyyyyyyyy
MFA_ENFORCE=false
MFA_ISSUER=RetroBurger
# Facturación CFDI (México). sandbox = SIMULADO sin validez fiscal (por defecto en desarrollo); en producción sólo un PAC real
# FISCAL_PROVIDER=sandbox
# URL pública del sitio de clientes (se imprime en el ticket para autofacturación)
PUBLIC_WEB_URL=http://localhost:5174
# Correo saliente (opcional). Sin SMTP_URL sólo se registra en el log.
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
MAIL_FROM="RetroBurger <no-reply@tu-dominio.com>"
