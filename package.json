{
  "name": "retroburger",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @retroburger/api db:migrate",
    "db:seed": "pnpm --filter @retroburger/api db:seed",
    "dev:api": "pnpm --filter @retroburger/api dev",
    "dev:web": "pnpm --filter @retroburger/web-admin dev"
  }
}
