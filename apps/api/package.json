{
  "name": "@retroburger/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node -r @swc-node/register src/database/migrate.ts",
    "db:seed": "node -r @swc-node/register src/database/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "@node-rs/argon2": "^2.0.0",
    "@retroburger/shared": "workspace:*",
    "fastify": "^5.12.5",
    "jose": "^5.9.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.13.0",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.4",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.1.0"
  }
}